# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION | منصة هندسة التعليمية
# ==============================================================================

# 1. Database (PostgreSQL - Neon / Supabase / VPS)
DATABASE_URL="postgresql://user:password@ep-sample-project.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 2. NextAuth (Auth.js) Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-at-least-32-chars-long"

# 3. Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. Super Admin Credentials (The Only Teacher/Admin)
ADMIN_EMAIL="eng.teacher@gmail.com"
ADMIN_PHONE="01012345678"

# 5. Bunny Stream (Secure Video Hosting)
BUNNY_API_KEY="your-bunny-stream-api-key"
BUNNY_LIBRARY_ID="123456"
BUNNY_TOKEN_AUTH_KEY="your-token-authentication-key"
BUNNY_CDN_HOSTNAME="vz-xxxxxx.b-cdn.net"

# 6. PDF Storage (Cloudflare R2 or AWS S3 Presigned URLs)
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-r2-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"
S3_BUCKET_NAME="handasa-pdfs"
S3_REGION="auto"

# 7. Egyptian Payment Gateway (Paymob)
PAYMOB_API_KEY="your-paymob-api-key"
PAYMOB_INTEGRATION_ID_CARD="123456"        # Integration ID for Bank Cards
PAYMOB_INTEGRATION_ID_WALLET="234567"      # Integration ID for Mobile Wallets (Vodafone Cash, etc.)
PAYMOB_INTEGRATION_ID_INSTAPAY="345678"    # Integration ID for InstaPay
PAYMOB_HMAC_SECRET="your-paymob-hmac-secret-for-webhook-verification"
PAYMOB_PUBLIC_KEY="your-paymob-public-key"

# 8. WhatsApp Business API (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID="your-meta-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-meta-permanent-system-user-token"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-waba-id"
WHATSAPP_VERIFY_TOKEN="your-custom-webhook-verify-token"

# 9. SMS Provider Alternative (e.g. SMSMisr / Vodafone)
SMS_SENDER_NAME="ENG-ACADEMY"
SMS_USERNAME="your-smsmisr-username"
SMS_PASSWORD="your-smsmisr-password"

# 10. Redis / BullMQ (Task Queue for Notifications)
REDIS_URL="redis://default:password@localhost:6379"

# 11. Security & Device Control
MAX_DEVICES_PER_STUDENT=1
SESSION_TOKEN_TTL_HOURS=24
